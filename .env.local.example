# Database Configuration
DB_USER=vocabuser
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_NAME=vocab_stack_db

# Application URLs (Change after Cloudflare setup)
API_URL=http://localhost:3000
DEPLOY_URL=http://localhost:3000

# Secret Key (Generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY

# Application Port (Backend API)
APP_PORT=8000

# Admin User Credentials (Created automatically on startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vocab.com
ADMIN_PASSWORD=admin123

# Cloudflare Tunnel Token (Add after Phase 2)
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
