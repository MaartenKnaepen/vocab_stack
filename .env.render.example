# Render.com Environment Variables Example
# Most of these are set automatically by render.yaml
# Only set these manually in Render dashboard if needed

# REQUIRED: Database location (set automatically by render.yaml)
DATABASE_URL=sqlite:////data/vocab_stack.db

# REQUIRED: Secret key (Render auto-generates this via render.yaml)
# No need to set manually - Render creates a secure random value
SECRET_KEY=auto-generated-by-render

# REQUIRED: Environment (set automatically by render.yaml)
ENV=production
ENVIRONMENT=production

# REQUIRED: Your Render app URL (set after first deploy)
# Update this in Render dashboard after deployment
ALLOWED_ORIGINS=https://vocab-stack.onrender.com

# Optional: Python version (set automatically by render.yaml)
PYTHON_VERSION=3.11

# Optional: Session settings
SESSION_COOKIE_SECURE=True
SESSION_LIFETIME_DAYS=30

# Optional: CORS settings
CORS_ENABLED=True
CORS_ORIGINS=https://vocab-stack.onrender.com

# Optional: Rate limiting
RATE_LIMIT_ENABLED=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30

# Optional: Force HTTPS
FORCE_HTTPS=True

# Optional: Debug (should be False in production)
DEBUG=False
